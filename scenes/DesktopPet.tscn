[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_bubble"]
content_margin_left = 12.0
content_margin_top = 8.0
content_margin_right = 12.0
content_margin_bottom = 8.0
bg_color = Color(1, 1, 1, 0.95)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.25, 0.2, 0.3, 1)
corner_radius_top_left = 12
corner_radius_top_right = 12
corner_radius_bottom_right = 12
corner_radius_bottom_left = 12

[node name="DesktopPet" type="Node2D"]
script = ExtResource("1_pet")

[node name="Sprite" type="SpineSprite" parent="."]
skeleton_data_res = ExtResource("2_waifu")

[node name="SpeechBubble" type="PanelContainer" parent="."]
visible = false
z_index = 10
offset_right = 40.0
offset_bottom = 40.0
mouse_filter = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_bubble")
script = ExtResource("3_bubble")

[node name="Label" type="Label" parent="SpeechBubble"]
layout_mode = 2
theme_override_colors/font_color = Color(0.15, 0.12, 0.2, 1)
theme_override_font_sizes/font_size = 14
horizontal_alignment = 1
autowrap_mode = 3

[node name="HideTimer" type="Timer" parent="SpeechBubble"]
one_shot = true

[node name="ContextMenu" type="PopupMenu" parent="."]

[node name="StateMachine" type="Node" parent="." node_paths=PackedStringArray("initial_state")]
